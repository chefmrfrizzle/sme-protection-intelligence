# The deterministic public demo requires no secrets.
DEMO_MODE=true
AI_MODE=replay
NEXT_PUBLIC_PRODUCT_WORDMARK=[PRODUCT]

# Optional signed-in workspace. Vercel's Supabase integration supplies these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only database/storage values. Never add NEXT_PUBLIC_, print, or commit values.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
